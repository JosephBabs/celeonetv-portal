{
  "name": "celeone-frontend-portal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/fonts/*",
      "!/spark/*",
      "!/docs/*",
      "!/favicon.png",
      "!/logo.png",
      "!/logo.jpeg",
      "!/hero-image.png",
      "!/feature-img.png",
      "!/ads.txt",
      "!/robots.txt",
      "!/sitemap.xml",
      "!/google*.html"
    ]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "celeone-e5843"
  }
}
